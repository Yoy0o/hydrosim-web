{
  "name": "hydrosim-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based 2D shallow-water hydrodynamic simulator (WebGPU + Web Worker + Three.js)",
  "keywords": [
    "hydrodynamics",
    "shallow-water-equations",
    "flood-simulation",
    "webgpu",
    "threejs",
    "typescript",
    "gis",
    "dam-break"
  ],
  "license": "MIT",
  "homepage": "https://github.com/Yoy0o/hydrosim-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yoy0o/hydrosim-web.git"
  },
  "bugs": {
    "url": "https://github.com/Yoy0o/hydrosim-web/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch-dem": "node scripts/fetch-dem.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "leaflet": "^1.9.4",
    "pbf": "^5.1.2",
    "three": "^0.187.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/three": "^0.187.0",
    "@webgpu/types": "^0.1.74",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
